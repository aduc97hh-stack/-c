NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: validated uploads / authorized scheduler; never public.
# Test provisioning belongs to a separate local/staging job, not web runtime.
SUPABASE_SERVICE_ROLE_KEY=
GAMI_SEED_PASSWORD=
GAMI_ALLOW_DEMO_SEED=no
# Hosted deployment preflight only; keep local/staging/production bindings separate.
# Set staging or production for node scripts/check-deployment.mjs.
GAMI_DEPLOY_ENVIRONMENT=local
GAMI_APP_URL=
SUPABASE_PROJECT_REF=
# Separate provisioning job only. Never set these passwords in the web runtime.
GAMI_STAGING_PROJECT_REF=
GAMI_STAGING_ADMIN_PASSWORD=
GAMI_STAGING_TEACHER_PASSWORD=
GAMI_STAGING_CSKH_PASSWORD=
